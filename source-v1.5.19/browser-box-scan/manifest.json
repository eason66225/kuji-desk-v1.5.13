{
  "manifest_version": 3,
  "name": "一番賞選箱掃描",
  "version": "1.1.2",
  "description": "讀取目前選箱頁，顯示符合籤數的箱子。",
  "permissions": [
    "activeTab",
    "scripting",
    "alarms",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  }
}
